# 复制为 .env 并填入你的配置；.env 已被 .gitignore 忽略，不会提交。
# 优先级：真实环境变量 > .env 文件 > 代码默认值。

# OpenAI 兼容 API（必填）
OPENAI_API_KEY=sk-your-key-here
# 自定义端点（默认 https://api.openai.com/v1；中转/代理/其他兼容服务在此改）
# OPENAI_BASE_URL=https://api.openai.com/v1
# 模型名（默认 gpt-4o-mini）
# OPENAI_MODEL=gpt-4o-mini

# 工具执行 Runtime：local（默认，直接本机执行）/ nix（exec 走 nix develop devShell）
# / ssh（全部副作用经 ssh 转发到远程主机执行，见下方 MYAGENT_SSH_*）
# MYAGENT_RUNTIME=local

# ---- MYAGENT_RUNTIME=ssh 时的连接配置（其余 runtime 忽略）----
# 远程主机，可含 user@ 前缀（必填；需已配置免密登录：ssh-copy-id <user>@<host>）
# MYAGENT_SSH_HOST=dok@192.168.64.11
# ssh 端口（默认 22）
# MYAGENT_SSH_PORT=22
# 远程项目根（默认远程 home，即 ssh 非交互登录后的 $HOME）；文件/exec 都落在远程此目录
# MYAGENT_SSH_ROOT=/home/dok/project

# 只读模式：1 或 true 开启——禁止 write_file / edit_file / exec
# MYAGENT_READ_ONLY=0

# 沙箱：1 或 true 开启——exec（cargo 及衍生 build.rs / proc-macro / 测试二进制）
# 放进 macOS Seatbelt 沙箱（sandbox-exec），仅允许写工作目录与 TMPDIR，默认禁网。
# 仅 macOS 可用；构造失败会直接报错退出，绝不静默降级为不隔离。
# MYAGENT_SANDBOX=0

# 沙箱内放行网络：1 或 true 开启（默认关；不随 MYAGENT_SANDBOX=1 隐式开启）
# MYAGENT_SANDBOX_NETWORK=0

# 显示模型推理过程（暗色 💭 前缀，仅展示不进对话历史）：MYAGENT_SHOW_REASONING=0

# exec 命令超时（秒），默认 60；冷构建/LTO 较慢时可调大
# MYAGENT_EXEC_TIMEOUT_SECS=60

# 会话持久化文件（默认 session.json）
# MYAGENT_SESSION=session.json

# REPL 命令历史文件（默认 .myagent_history；tty 交互模式写入，非 tty 不使用）
# MYAGENT_HISTORY=.myagent_history
